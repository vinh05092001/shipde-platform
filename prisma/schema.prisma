// ============================================================================
// Ship Dễ — Database Schema for PostgreSQL 16+ (Tập 1, 2, 4)
// Thiết kế bảo đảm: Append-only Events, Multi-tenant Isolation, Immutable Audits,
// Maker-Checker Segregation, 6 Discrepancy Rules & Optimistic Locking.
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleEnum {
  OWNER
  OPS_CSKH
  WAREHOUSE
  ACCOUNTANT
  PLATFORM_ADMIN
}

enum CarrierCodeEnum {
  GHN
  GHTK
  VIETTEL_POST
  JT
}

enum CarrierTierEnum {
  L0_OBSERVE
  L1_ASSIST
  L2_EXECUTE
}

enum ShipmentStatusEnum {
  DRAFT
  PICKING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNING
  RETURNED
  CANCELLED
  LOST
  DAMAGED
}

enum ExceptionTypeEnum {
  PICKUP_DELAY
  STUCK_IN_TRANSIT
  DELIVERY_FAIL
  STATUS_MISMATCH
}

enum ExceptionCaseStatusEnum {
  OPEN
  ASSIGNED
  CONTACTING
  WAITING_CUSTOMER
  REATTEMPT_REQUESTED
  WAITING_REATTEMPT
  RESCUED
  RETURNING
  RETURNED
  UNRESOLVED
}

enum MatchingStatusEnum {
  MATCHED_EXACT
  MATCHED_FUZZY
  UNMATCHED
  AMBIGUOUS
}

enum DiscrepancyTypeEnum {
  D1_WEIGHT
  D2_FREIGHT
  D3_SURCHARGE
  D4_DUPLICATE
  D5_COD_MISMATCH
  D6_OVERDUE_COD
  D7_MISSING
}

enum DiscrepancyStatusEnum {
  OPEN
  CONFIRMED
  DISPUTED
  WAIVED
  CARRIED_FORWARD
  RESOLVED
}

enum ClaimStatusEnum {
  DRAFT
  SUBMITTED
  IN_REVIEW
  ACCEPTED
  REJECTED
  CLOSED
}

enum SessionStatusEnum {
  ACTIVE
  REVOKED
  EXPIRED
  INACTIVE
}

enum InvitationStatusEnum {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ----------------------------------------------------------------------------
// 1. IAM & Multi-tenant Organization
// ----------------------------------------------------------------------------

model Merchant {
  id                String            @id @default(uuid()) @db.Uuid
  name              String            @db.VarChar(255)
  code              String            @unique @db.VarChar(64)
  status            String            @default("active") @db.VarChar(32)
  created_at        DateTime          @default(now()) @db.Timestamptz
  updated_at        DateTime          @updatedAt @db.Timestamptz

  // Shop profile (FEAT-ORG-01: legal, billing, and operating defaults)
  legal_name          String?           @db.VarChar(255)
  tax_code            String?           @db.VarChar(32)
  contact_email       String?           @db.VarChar(255)
  contact_phone       String?           @db.VarChar(32)
  legal_address       String?           @db.Text
  billing_email       String?           @db.VarChar(255)
  billing_address     String?           @db.Text
  bank_name           String?           @db.VarChar(128)
  bank_account_number String?           @db.VarChar(64)
  bank_account_name   String?           @db.VarChar(255)
  bank_branch         String?           @db.VarChar(255)
  timezone            String            @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  currency            String            @default("VND") @db.VarChar(16)
  default_fee_payer   String            @default("SHOP") @db.VarChar(32)
  default_weight_unit String            @default("g") @db.VarChar(16)
  auto_routing_enabled Boolean          @default(false)
  operating_notes     String?           @db.VarChar(1000)

  users             User[]
  carrier_accounts  CarrierAccount[]
  rate_cards        RateCard[]
  orders            Order[]
  shipments         Shipment[]
  exception_cases   ExceptionCase[]
  return_records    ReturnRecord[]
  statements        CarrierStatement[]
  discrepancies     Discrepancy[]
  claims            Claim[]
  audit_logs        AuditLog[]
  device_sessions   DeviceSession[]
  mfa_factors       MfaFactor[]
  mfa_challenges    MfaChallenge[]
  mfa_admin_reset_idempotency MfaAdminResetIdempotency[]
  invitations       Invitation[]
  roles             Role[]
  warehouses        Warehouse[]
  branches          Branch[]
  imports           Import[]

  @@index([tax_code])
  @@map("merchants")
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  merchant_id       String?           @db.Uuid
  email             String?           @unique @db.VarChar(255)
  phone             String?           @unique @db.VarChar(32)
  full_name         String            @db.VarChar(255)
  password_hash     String            @db.VarChar(255)
  role              RoleEnum
  store_scopes            String[]          @default([])
  warehouse_scopes        String[]          @default([])
  carrier_account_scopes  String[]          @default([])
  status            String            @default("pending_verification") @db.VarChar(32)
  email_verified_at DateTime?         @db.Timestamptz
  phone_verified_at DateTime?         @db.Timestamptz
  terms_accepted_at DateTime?         @db.Timestamptz
  terms_version     String?           @db.VarChar(32)
  // Database-ownership / BR-RBAC-04: FK users_custom_role_id_fkey is defined authoritatively in migration.sql as
  // ON DELETE NO ACTION DEFERRABLE INITIALLY DEFERRED (so merchant cascade and in-use role delete have one defined outcome).
  // Kept unmanaged by Prisma relation to ensure prisma db push / migrate diff cannot replace or drop the deferrable constraint.
  custom_role_id    String?           @db.Uuid
  avatar_url        String?           @db.VarChar(512)
  language          String            @default("vi") @db.VarChar(10)
  timezone          String            @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  notification_preferences Json?          @db.JsonB
  default_warehouse_id String?          @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz
  updated_at        DateTime          @updatedAt @db.Timestamptz

  merchant              Merchant?             @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  assigned_cases        ExceptionCase[]       @relation("CaseAssignee")
  contact_logs          ExceptionContactLog[]
  device_sessions       DeviceSession[]
  verification_tokens   VerificationToken[]
  password_reset_tokens PasswordResetToken[]
  mfa_factors           MfaFactor[]
  mfa_challenges        MfaChallenge[]
  invitations_sent      Invitation[]          @relation("InvitationsSent")

  @@index([merchant_id, role])
  @@index([merchant_id, custom_role_id])
  @@map("users")
}

model VerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  token       String    @unique @db.VarChar(255)
  channel     String    @db.VarChar(16)
  identifier  String    @db.VarChar(255)
  otp         String?   @db.VarChar(64)
  // FEAT-AUTH-03: VERIFICATION tokens activate an account; LOGIN tokens authorize an OTP login.
  purpose     String    @default("VERIFICATION") @db.VarChar(32)
  expires_at  DateTime  @db.Timestamptz
  consumed_at DateTime? @db.Timestamptz
  created_at  DateTime  @default(now()) @db.Timestamptz

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([identifier, channel])
  @@index([purpose])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  token        String    @unique @db.VarChar(255)
  channel      String    @db.VarChar(16)
  identifier   String    @db.VarChar(255)
  expires_at   DateTime  @db.Timestamptz
  consumed_at  DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([identifier, channel])
  @@map("password_reset_tokens")
}

model Invitation {
  id                 String               @id @default(uuid()) @db.Uuid
  merchant_id        String               @db.Uuid
  email              String?              @db.VarChar(255)
  phone              String?              @db.VarChar(32)
  role               RoleEnum
  store_scopes            String[]             @default([])
  warehouse_scopes        String[]             @default([])
  carrier_account_scopes  String[]             @default([])
  token_hash         String               @unique @db.VarChar(255)
  status             InvitationStatusEnum @default(PENDING)
  invited_by_user_id String?              @db.Uuid
  expires_at         DateTime             @db.Timestamptz
  consumed_at        DateTime?            @db.Timestamptz
  created_at         DateTime             @default(now()) @db.Timestamptz
  updated_at         DateTime             @updatedAt @db.Timestamptz

  merchant           Merchant             @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  invited_by         User?                @relation("InvitationsSent", fields: [invited_by_user_id], references: [id], onDelete: SetNull)

  // Authoritative schema & migration path (Round 6 Finding 8 / BR-INV-08) (Round 10 Finding 1):
  // Partial unique indexes "invitations_merchant_pending_email_unique" and
  // "invitations_merchant_pending_phone_unique" (WHERE status = 'PENDING' AND email/phone IS NOT NULL)
  // are created exclusively via PostgreSQL migration DDL in prisma/migrations/...
  // They are strictly omitted from schema.prisma because Prisma does not support partial indexes;
  // declaring non-unique @@index with these names would drop the partial unique constraints.
  // Guarded against drift by migration-guard.ts and CI validation.
  @@index([merchant_id, status])
  @@index([expires_at])
  @@map("invitations")
}

model DeviceSession {
  id                 String            @id @default(uuid()) @db.Uuid
  user_id            String            @db.Uuid
  merchant_id        String?           @db.Uuid
  session_token_hash String            @unique @db.VarChar(512)
  device_id          String            @db.VarChar(255)
  device_model       String?           @db.VarChar(255)
  user_agent         String?           @db.Text
  ip_address         String?           @db.VarChar(64)
  fcm_token          String?           @db.Text
  is_revoked         Boolean           @default(false)
  status             SessionStatusEnum @default(ACTIVE)
  last_active_at     DateTime          @default(now()) @db.Timestamptz
  expires_at         DateTime          @db.Timestamptz
  revoked_at         DateTime?         @db.Timestamptz
  revoked_by         String?           @db.VarChar(255)
  revoke_reason      String?           @db.VarChar(255)
  mfa_verified_at    DateTime?         @db.Timestamptz
  auth_assurance     String            @default("PASSWORD") @db.VarChar(32)
  created_at         DateTime          @default(now()) @db.Timestamptz

  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  merchant           Merchant?         @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id, user_id, status])
  @@index([user_id, status])
  @@index([user_id, is_revoked])
  @@map("device_sessions")
}


// ----------------------------------------------------------------------------
// 1b. Two-Factor Authentication (FEAT-AUTH-05: ENT-MFA-FACTOR, ENT-MFA-RECOVERY-CODE, ENT-MFA-CHALLENGE)
// ----------------------------------------------------------------------------

model MfaFactor {
  id                 String            @id @default(uuid()) @db.Uuid
  user_id            String            @db.Uuid
  merchant_id        String            @db.Uuid
  type               String            @default("TOTP") @db.VarChar(32)
  status             String            @default("PENDING") @db.VarChar(32) // PENDING | ACTIVE | RESET
  secret_ciphertext  String            @db.Text
  key_version        Int               @default(1)
  setup_expires_at   DateTime?         @db.Timestamptz
  activated_at       DateTime?         @db.Timestamptz
  reset_at           DateTime?         @db.Timestamptz
  last_accepted_step BigInt?
  created_by         String?           @db.VarChar(255)
  updated_by         String?           @db.VarChar(255)
  created_at         DateTime          @default(now()) @db.Timestamptz
  updated_at         DateTime          @updatedAt @db.Timestamptz

  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  merchant           Merchant          @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  recovery_codes     MfaRecoveryCode[]

  @@index([user_id, status])
  @@index([merchant_id, user_id])
  @@map("mfa_factors")
}

model MfaAdminResetIdempotency {
  id              String   @id @default(uuid()) @db.Uuid
  merchant_id     String   @db.Uuid
  idempotency_key String   @db.VarChar(128)
  actor_user_id   String   @db.Uuid
  target_user_id  String   @db.Uuid
  reason          String   @db.Text
  response        Json
  created_at      DateTime @default(now()) @db.Timestamptz

  merchant        Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@unique([merchant_id, idempotency_key])
  @@map("mfa_admin_reset_idempotency")
}

model MfaRecoveryCode {
  id                      String    @id @default(uuid()) @db.Uuid
  factor_id               String    @db.Uuid
  code_hash               String    @db.VarChar(255)
  consumed_at             DateTime? @db.Timestamptz
  consumed_by_session_id  String?   @db.VarChar(255)
  consumed_correlation_id String?   @db.VarChar(255)
  created_at              DateTime  @default(now()) @db.Timestamptz

  factor                  MfaFactor @relation(fields: [factor_id], references: [id], onDelete: Cascade)

  @@index([factor_id, consumed_at])
  @@index([code_hash])
  @@map("mfa_recovery_codes")
}

model MfaChallenge {
  id                    String    @id @default(uuid()) @db.Uuid
  challenge_hash        String    @unique @db.VarChar(255)
  user_id               String    @db.Uuid
  merchant_id           String    @db.Uuid
  login_transaction_ref String?   @db.VarChar(255)
  purpose               String    @default("MFA_LOGIN") @db.VarChar(32)
  expires_at            DateTime  @db.Timestamptz
  failed_attempts       Int       @default(0)
  consumed_at           DateTime? @db.Timestamptz
  invalidated_at        DateTime? @db.Timestamptz
  correlation_id        String?   @db.VarChar(255)
  created_at            DateTime  @default(now()) @db.Timestamptz

  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  merchant              Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([user_id, consumed_at, expires_at])
  @@index([challenge_hash])
  @@map("mfa_challenges")
}

// ----------------------------------------------------------------------------
// 1c. Roles & Permissions (FEAT-RBAC-01: Role, Permission, RolePermission)
// ----------------------------------------------------------------------------

model Role {
  id                String            @id @default(uuid()) @db.Uuid
  merchant_id       String?           @db.Uuid
  code              String?           @unique @db.VarChar(64)
  name              String            @db.VarChar(255)
  name_lower        String?           @db.VarChar(255)
  description       String?           @db.Text
  is_system         Boolean           @default(false)
  created_at        DateTime          @default(now()) @db.Timestamptz
  updated_at        DateTime          @updatedAt @db.Timestamptz

  merchant          Merchant?         @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  permissions       RolePermission[]

  @@unique([merchant_id, name_lower])
  @@index([merchant_id, is_system])
  @@map("roles")
}

model Permission {
  id                String            @id @default(uuid()) @db.Uuid
  code              String            @unique @db.VarChar(128)
  name              String            @db.VarChar(255)
  description       String?           @db.Text
  category          String            @db.VarChar(64)
  created_at        DateTime          @default(now()) @db.Timestamptz

  role_permissions  RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id                String            @id @default(uuid()) @db.Uuid
  role_id           String            @db.Uuid
  permission_id     String            @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz

  role              Role              @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission        Permission        @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
  @@map("role_permissions")
}

// ----------------------------------------------------------------------------
// 1.1 Warehouses (FEAT-WH-01: Pickup/Return address, schedule, contacts, printer defaults)
// ----------------------------------------------------------------------------

model Warehouse {
  id                          String    @id @default(uuid()) @db.Uuid
  merchant_id                 String    @db.Uuid
  name                        String    @db.VarChar(255)
  code                        String    @db.VarChar(64)
  status                      String    @default("active") @db.VarChar(32)
  is_default                  Boolean   @default(false)

  // Pickup address
  contact_name                String    @db.VarChar(255)
  contact_phone               String    @db.VarChar(32)
  contact_email               String?   @db.VarChar(255)
  address_line                String    @db.Text
  ward                        String?   @db.VarChar(128)
  district                    String    @db.VarChar(128)
  city                        String    @db.VarChar(128)
  postal_code                 String?   @db.VarChar(32)
  address_json                Json      @db.JsonB

  // Return address (custom if use_different_return_address is true, else mirrors pickup)
  use_different_return_address Boolean   @default(false)
  return_contact_name         String?   @db.VarChar(255)
  return_contact_phone        String?   @db.VarChar(32)
  return_address_line         String?   @db.Text
  return_ward                 String?   @db.VarChar(128)
  return_district             String?   @db.VarChar(128)
  return_city                 String?   @db.VarChar(128)
  return_address_json         Json?     @db.JsonB

  // Schedule & operating hours
  operating_hours             Json?     @db.JsonB
  cutoff_time                 String?   @db.VarChar(10)
  schedule_notes              String?   @db.VarChar(500)

  // Contacts (secondary/escalation contacts)
  contacts_json               Json?     @db.JsonB

  // Printer defaults
  printer_paper_size          String    @default("A6") @db.VarChar(32)
  printer_dpi                 Int       @default(203)
  printer_name                String?   @db.VarChar(255)
  printer_auto_print          Boolean   @default(false)
  printer_config              Json?     @db.JsonB

  created_at                  DateTime  @default(now()) @db.Timestamptz
  updated_at                  DateTime  @updatedAt @db.Timestamptz

  merchant                    Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@unique([merchant_id, code])
  @@unique([id, merchant_id])
  @@index([merchant_id, status])
  @@index([merchant_id, is_default])
  @@map("warehouses")
}

// ----------------------------------------------------------------------------
// FEAT-COM-04: Branches & Imports Data Models
// ----------------------------------------------------------------------------

model Branch {
  id                          String    @id @default(uuid()) @db.Uuid
  merchant_id                 String    @db.Uuid
  name                        String    @db.VarChar(255)
  code                        String    @db.VarChar(64)
  status                      String    @default("active") @db.VarChar(32)
  is_default                  Boolean   @default(false)

  // Contact & Address
  contact_name                String?   @db.VarChar(255)
  contact_phone               String?   @db.VarChar(32)
  address_line                String?   @db.Text
  ward                        String?   @db.VarChar(128)
  district                    String?   @db.VarChar(128)
  city                        String?   @db.VarChar(128)

  created_at                  DateTime  @default(now()) @db.Timestamptz
  updated_at                  DateTime  @updatedAt @db.Timestamptz

  merchant                    Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@unique([merchant_id, code])
  @@unique([id, merchant_id])
  @@index([merchant_id, status])
  @@map("branches")
}

model Import {
  id                          String    @id @default(uuid()) @db.Uuid
  merchant_id                 String    @db.Uuid
  template_type               String    @db.VarChar(64)
  file_name                   String    @db.VarChar(255)
  file_size                   Int
  file_hash                   String    @db.VarChar(64)
  mime_type                   String    @db.VarChar(128)
  storage_path                String?   @db.VarChar(512)
  status                      String    @default("UPLOADED") @db.VarChar(32)
  revision                    Int       @default(1)
  idempotency_key             String?   @db.VarChar(255)
  total_rows                  Int       @default(0)
  valid_rows                  Int       @default(0)
  error_rows                  Int       @default(0)
  warning_rows                Int       @default(0)
  control_totals              Json?     @db.JsonB
  created_by_user_id          String?   @db.Uuid
  promoted_by_user_id         String?   @db.Uuid
  promoted_at                 DateTime? @db.Timestamptz
  created_at                  DateTime  @default(now()) @db.Timestamptz
  updated_at                  DateTime  @updatedAt @db.Timestamptz

  merchant                    Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  rows                        ImportRow[]

  @@unique([merchant_id, template_type, revision])
  @@index([merchant_id, template_type])
  @@index([merchant_id, file_hash])
  @@index([merchant_id, idempotency_key])
  @@index([merchant_id, status])
  @@map("imports")
}

model ImportRow {
  id                          String    @id @default(uuid()) @db.Uuid
  import_id                   String    @db.Uuid
  row_number                  Int
  raw_data                    Json      @db.JsonB
  normalized_data             Json?     @db.JsonB
  status                      String    @db.VarChar(32)
  scope_identifier            String?   @db.VarChar(64)
  issues_json                 Json?     @db.JsonB
  created_at                  DateTime  @default(now()) @db.Timestamptz

  import                      Import    @relation(fields: [import_id], references: [id], onDelete: Cascade)

  @@index([import_id, status])
  @@index([import_id, row_number])
  @@map("import_rows")
}

// ----------------------------------------------------------------------------
// 2. Carrier Accounts & Versioned Rate Cards
// ----------------------------------------------------------------------------

model CarrierAccount {
  id                String            @id @default(uuid()) @db.Uuid
  merchant_id       String            @db.Uuid
  carrier_code      CarrierCodeEnum
  label             String            @db.VarChar(128)
  encrypted_credentials String        @db.Text // Encrypted with master key outside DB
  tier              CarrierTierEnum   @default(L1_ASSIST)
  status            String            @default("active") @db.VarChar(32)
  created_at        DateTime          @default(now()) @db.Timestamptz
  expires_at        DateTime?         @db.Timestamptz

  merchant          Merchant          @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  rate_cards        RateCard[]
  shipments         Shipment[]
  statements        CarrierStatement[]

  @@unique([merchant_id, label])
  @@index([merchant_id, carrier_code])
  @@map("carrier_accounts")
}

model RateCard {
  id                   String         @id @default(uuid()) @db.Uuid
  merchant_id          String         @db.Uuid
  carrier_account_id   String         @db.Uuid
  version              Int            @default(1)
  effective_from       DateTime       @db.Date
  effective_to         DateTime?      @db.Date
  volumetric_divisor   Int            @default(5000) // 5000 hoặc 6000
  cod_payout_sla_days  Int            @default(3)    // Hạn chuyển COD (ngày)
  checksum             String         @db.VarChar(64)
  created_at           DateTime       @default(now()) @db.Timestamptz

  merchant             Merchant       @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  carrier_account      CarrierAccount @relation(fields: [carrier_account_id], references: [id], onDelete: Cascade)
  tiers                RateTier[]

  @@index([carrier_account_id, effective_from, effective_to])
  @@map("rate_cards")
}

model RateTier {
  id                   String         @id @default(uuid()) @db.Uuid
  rate_card_id         String         @db.Uuid
  route_type           String         @db.VarChar(32) // INTRA_PROVINCE, INTER_PROVINCE, SPECIAL
  weight_from_g        Int
  weight_to_g          Int
  base_fee             BigInt         // Đơn vị VNĐ
  step_fee             BigInt         @default(0)
  step_weight_g        Int            @default(0)

  rate_card            RateCard       @relation(fields: [rate_card_id], references: [id], onDelete: Cascade)

  @@index([rate_card_id, route_type, weight_from_g, weight_to_g])
  @@map("rate_tiers")
}

// ----------------------------------------------------------------------------
// 3. Orders & Shipment Ledger (Append-Only Events)
// ----------------------------------------------------------------------------

model Order {
  id                   String         @id @default(uuid()) @db.Uuid
  merchant_id          String         @db.Uuid
  source_type          String         @default("pancake") @db.VarChar(32)
  order_code           String         @db.VarChar(128)
  created_at           DateTime       @db.Timestamptz
  cod_amount           BigInt         @default(0)
  declared_weight_g    Int            @default(0)
  dimensions           Json?          // { length, width, height }
  recipient_name       String         @db.VarChar(255)
  recipient_phone      String         @db.VarChar(32)
  recipient_province   String         @db.VarChar(128)
  recipient_address    String         @db.Text
  item_value           BigInt?        @default(0)

  merchant             Merchant       @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  shipments            Shipment[]

  @@unique([merchant_id, order_code])
  @@index([merchant_id, created_at])
  @@map("orders")
}

model Shipment {
  id                   String             @id @default(uuid()) @db.Uuid
  merchant_id          String             @db.Uuid
  order_id             String             @db.Uuid
  order_code           String             @db.VarChar(128)
  carrier_code         CarrierCodeEnum
  carrier_account_id   String             @db.Uuid
  tracking_code        String             @db.VarChar(128) // Chuẩn hóa viết hoa, không khoảng trắng
  current_status       ShipmentStatusEnum @default(DRAFT)
  declared_weight_g    Int                @default(0)
  charged_weight_g     Int?
  dimensions           Json?
  quoted_fee           BigInt             @default(0)
  charged_fee          BigInt?
  cod_amount           BigInt             @default(0)
  cod_collected        BigInt?
  cod_paid_at          DateTime?          @db.Timestamptz
  delivered_at         DateTime?          @db.Timestamptz
  created_at           DateTime           @default(now()) @db.Timestamptz
  version              Int                @default(1) // Khóa lạc quan BR-27
  last_modified_by     String?            @db.VarChar(255)

  merchant             Merchant           @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  order                Order              @relation(fields: [order_id], references: [id], onDelete: Cascade)
  carrier_account      CarrierAccount     @relation(fields: [carrier_account_id], references: [id], onDelete: Cascade)
  events               ShipmentEvent[]
  exceptions           ExceptionCase[]
  return_record        ReturnRecord?
  discrepancies        Discrepancy[]
  claims               Claim[]

  @@unique([merchant_id, tracking_code])
  @@index([merchant_id, current_status])
  @@index([merchant_id, delivered_at])
  @@map("shipments")
}

model ShipmentEvent {
  id                   String             @id @default(uuid()) @db.Uuid
  shipment_id          String             @db.Uuid
  raw_status           String             @db.VarChar(128)
  normalized_status    ShipmentStatusEnum
  occurred_at          DateTime           @db.Timestamptz // Cột quyết định trạng thái (BR-03, BR-32)
  received_at          DateTime           @default(now()) @db.Timestamptz
  source               String             @db.VarChar(32) // WEBHOOK, POLLING
  raw_payload          Json?

  shipment             Shipment           @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@unique([shipment_id, raw_status, occurred_at]) // Chống trùng sự kiện (BR-17)
  @@index([shipment_id, occurred_at])
  @@map("shipment_events")
}

// ----------------------------------------------------------------------------
// 4. Exception Cases & Rescuing (BR-31, BR-32, BR-33)
// ----------------------------------------------------------------------------

model ExceptionCase {
  id                   String                  @id @default(uuid()) @db.Uuid
  merchant_id          String                  @db.Uuid
  shipment_id          String                  @db.Uuid
  tracking_code        String                  @db.VarChar(128)
  exception_type       ExceptionTypeEnum
  status               ExceptionCaseStatusEnum @default(OPEN)
  assigned_to          String?                 @db.Uuid
  locked_until         DateTime?               @db.Timestamptz // Khóa mềm 30 phút (CN-09)
  deadline_at          DateTime                @db.Timestamptz // Tính từ occurred_at của hãng
  priority_score       Int                     @default(0)
  carrier_raw_reason   String?                 @db.Text
  standard_reason      String?                 @db.VarChar(255)
  version              Int                     @default(1)     // Khóa lạc quan
  created_at           DateTime                @default(now()) @db.Timestamptz
  updated_at           DateTime                @updatedAt @db.Timestamptz

  merchant             Merchant                @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  shipment             Shipment                @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  assignee             User?                   @relation("CaseAssignee", fields: [assigned_to], references: [id])
  contact_logs         ExceptionContactLog[]

  @@unique([shipment_id, exception_type]) // Ràng buộc duy nhất 1 hồ sơ mở cho mỗi cặp (BR-31)
  @@index([merchant_id, status, deadline_at])
  @@map("exception_cases")
}

model ExceptionContactLog {
  id                   String            @id @default(uuid()) @db.Uuid
  case_id              String            @db.Uuid
  user_id              String            @db.Uuid
  channel              String            @db.VarChar(32) // PHONE, ZALO, SMS
  result               String            @db.VarChar(32) // ANSWERED, NO_ANSWER, WRONG_NUMBER, REFUSED
  note                 String            @db.Text
  created_at           DateTime          @default(now()) @db.Timestamptz

  exception_case       ExceptionCase     @relation(fields: [case_id], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([case_id, created_at])
  @@map("exception_contact_logs")
}

// ----------------------------------------------------------------------------
// 5. Return Management & Scanning (BR-35, BR-36, BR-40)
// ----------------------------------------------------------------------------

model ReturnRecord {
  id                   String            @id @default(uuid()) @db.Uuid
  merchant_id          String            @db.Uuid
  shipment_id          String            @unique @db.Uuid
  tracking_code        String            @db.VarChar(128)
  return_warehouse_id  String?           @db.VarChar(128)
  expected_return_at   DateTime?         @db.Timestamptz
  received_at          DateTime?         @db.Timestamptz
  condition            String?           @db.VarChar(32) // INTACT, DAMAGED, MISSING_ITEM
  evidence_urls        String[]          @default([])
  evidence_checksum    String?           @db.VarChar(64)
  received_by          String?           @db.VarChar(255)
  created_at           DateTime          @default(now()) @db.Timestamptz

  merchant             Merchant          @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  shipment             Shipment          @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@index([merchant_id, expected_return_at])
  @@map("return_records")
}

// ----------------------------------------------------------------------------
// 6. Reconciliation, Statements & Discrepancies (BR-11, BR-12, D1-D7)
// ----------------------------------------------------------------------------

model CarrierStatement {
  id                   String            @id @default(uuid()) @db.Uuid
  merchant_id          String            @db.Uuid
  carrier_account_id   String            @db.Uuid
  period_start         DateTime          @db.Date
  period_end           DateTime          @db.Date
  checksum             String            @db.VarChar(64) // SHA-256 file gốc (BR-02, CN-13)
  file_storage_key     String            @db.VarChar(512)
  total_rows           Int               @default(0)
  total_cod_collected  BigInt            @default(0)
  total_fees           BigInt            @default(0)
  status               String            @default("DRAFT") @db.VarChar(32) // DRAFT, RECONCILED, CLOSED
  closed_at            DateTime?         @db.Timestamptz
  closed_by            String?           @db.VarChar(255)
  created_at           DateTime          @default(now()) @db.Timestamptz

  merchant             Merchant          @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  carrier_account      CarrierAccount    @relation(fields: [carrier_account_id], references: [id], onDelete: Cascade)
  rows                 StatementRow[]

  @@unique([merchant_id, carrier_account_id, checksum]) // Từ chối file trùng (CN-13)
  @@index([merchant_id, period_start, period_end])
  @@map("carrier_statements")
}

model StatementRow {
  id                   String              @id @default(uuid()) @db.Uuid
  statement_id         String              @db.Uuid
  line_number          Int
  tracking_code        String              @db.VarChar(128)
  order_code           String?             @db.VarChar(128)
  fee_type             String              @db.VarChar(64)
  charged_weight_g     Int                 @default(0)
  charged_fee          BigInt              @default(0)
  cod_collected        BigInt              @default(0)
  cod_paid_at          DateTime?           @db.Date
  raw_data             Json
  match_status         MatchingStatusEnum  @default(UNMATCHED)
  matched_shipment_id  String?             @db.Uuid

  statement            CarrierStatement    @relation(fields: [statement_id], references: [id], onDelete: Cascade)
  discrepancies        Discrepancy[]

  @@index([statement_id, tracking_code])
  @@map("statement_rows")
}

model Discrepancy {
  id                   String                @id @default(uuid()) @db.Uuid
  merchant_id          String                @db.Uuid
  statement_row_id     String?               @db.Uuid
  shipment_id          String                @db.Uuid
  tracking_code        String                @db.VarChar(128)
  type                 DiscrepancyTypeEnum
  amount               BigInt                @default(0) // Số tiền chênh lệch (VNĐ)
  status               DiscrepancyStatusEnum @default(OPEN)
  reason               String?               @db.Text   // Bắt buộc khi waive/resolve (BR-22)
  resolved_by          String?               @db.VarChar(255)
  resolved_at          DateTime?             @db.Timestamptz
  evidence_files       String[]              @default([])
  version              Int                   @default(1)
  created_at           DateTime              @default(now()) @db.Timestamptz

  merchant             Merchant              @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  statement_row        StatementRow?         @relation(fields: [statement_row_id], references: [id])
  shipment             Shipment              @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  claims               Claim[]

  @@index([merchant_id, status, type])
  @@map("discrepancies")
}

// ----------------------------------------------------------------------------
// 7. Claims & Immutable Audit Logs (BR-21, BR-47, BR-48)
// ----------------------------------------------------------------------------

model Claim {
  id                   String            @id @default(uuid()) @db.Uuid
  merchant_id          String            @db.Uuid
  shipment_id          String            @db.Uuid
  discrepancy_id       String?           @db.Uuid
  claim_type           String            @db.VarChar(32) // LOST, DAMAGED, FEE, COD
  carrier_ticket       String?           @db.VarChar(128)
  requested_amount     BigInt            @default(0)
  accepted_amount      BigInt            @default(0)
  recovered_amount     BigInt            @default(0) // Chỉ ghi khi tiền thực về (Sổ 1)
  status               ClaimStatusEnum   @default(DRAFT)
  deadline_at          DateTime          @db.Timestamptz
  evidence_pack_url    String?           @db.VarChar(512)
  created_at           DateTime          @default(now()) @db.Timestamptz
  updated_at           DateTime          @updatedAt @db.Timestamptz

  merchant             Merchant          @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  shipment             Shipment          @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  discrepancy          Discrepancy?      @relation(fields: [discrepancy_id], references: [id])

  @@index([merchant_id, status, deadline_at])
  @@map("claims")
}

model AuditLog {
  id                   String            @id @default(uuid()) @db.Uuid
  // merchant_id is nullable strictly for platform-level system audit events (such as system role seed reconciliation).
  // All tenant-scoped actions (roles, users, sessions) strictly require and populate merchant_id (Finding 1 / Round 14 / BR-RBAC-07 / BR-RBAC-04).
  merchant_id          String?           @db.Uuid
  user_id              String?           @db.VarChar(255)
  actor                String?           @db.VarChar(255)
  action               String            @db.VarChar(128)
  entity_type          String            @db.VarChar(64)
  entity_id            String            @db.VarChar(255)
  old_value            Json?
  new_value            Json?
  reason               String?           @db.Text
  ip_address           String?           @db.VarChar(64)
  created_at           DateTime          @default(now()) @db.Timestamptz // Bất biến (BR-02, BR-21)

  merchant             Merchant?         @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id, entity_type, entity_id])
  @@index([merchant_id, created_at])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// 8. Technical Outbox & Durable Dispatch Foundation (ENT-FOUND-OUTBOX)
// ----------------------------------------------------------------------------

enum OutboxStatusEnum {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id              String            @id @default(uuid()) @db.Uuid
  event_type      String            @db.VarChar(128)
  payload         Json
  correlation_id  String            @db.VarChar(128)
  status          OutboxStatusEnum  @default(PENDING)
  attempts        Int               @default(0)
  last_error      String?           @db.Text
  idempotency_key String?           @unique @db.VarChar(128)
  created_at      DateTime          @default(now()) @db.Timestamptz
  scheduled_at    DateTime          @default(now()) @db.Timestamptz
  published_at    DateTime?         @db.Timestamptz

  @@index([status, scheduled_at])
  @@index([correlation_id])
  @@map("outbox_events")
}
