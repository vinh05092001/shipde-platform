{
  "version": 3,
  "description": "Path and operation rules for the Pull Request contract. Product behavior, normative specs/decisions, dependencies, database/auth/money/carrier code, workflows, CI/security gate scripts and the contract itself require a Work Item (Tier B). Maintenance, AI tooling and AI-collaboration docs use PR-only evidence (Tier A / Tier G) with CI and independent exact-SHA review. The validator always reads this file from the protected base commit, never from the PR head.",
  "maintenance_title_pattern": "^(chore|docs|refactor|fix)(\\([a-z0-9._/-]+\\))?: \\S",
  "maintenance_body_headings": ["## Goal", "## Scope", "## Verification"],
  "governance_body_headings": ["## Goal", "## Scope", "## Preservation", "## Verification"],
  "maintenance_paths": ["docs/**", "*.md", ".evidence/**", "tools/ai-brain/test/**"],
  "scoped_governance_rules": [
    { "path": "AGENTS.md", "kinds": ["M"] },
    { "path": "CLAUDE.md", "kinds": ["M"] },
    { "path": "docs/product-spec/docs/10-ai-collaboration/**", "kinds": ["A", "M", "D"] },
    { "path": "docs/product-spec/evidence/**", "kinds": ["A", "M", "D"] },
    { "path": "scripts/**", "kinds": ["A", "M", "D"] },
    { "path": "tools/**", "kinds": ["A", "M", "D"] }
  ],
  "strict_protected_paths": [
    "**/*/AGENTS.md",
    "**/*/CLAUDE.md",
    ".github/**",
    "docs/product-spec/contracts/**",
    "docs/product-spec/scripts/**",
    "docs/product-spec/docs/00-control/**",
    "docs/product-spec/docs/01-product/**",
    "docs/product-spec/docs/02-business/**",
    "docs/product-spec/docs/03-ux/**",
    "docs/product-spec/docs/04-data/**",
    "docs/product-spec/docs/05-api-integrations/**",
    "docs/product-spec/docs/06-architecture/**",
    "docs/product-spec/docs/07-ai-build/**",
    "docs/product-spec/docs/08-testing/**",
    "docs/product-spec/docs/09-delivery/**",
    "**/openapi*.yaml",
    "**/openapi*.yml",
    "**/openapi*.json",
    ".gitleaks*",
    ".gitleaksignore",
    ".trivyignore",
    ".semgrep*",
    "tools/semgrep/**",
    "tools/openspec-check/**",
    "tools/k6/**",
    "tools/controller-eval/**",
    "scripts/verify-trivy.ts",
    "scripts/verify-*.ts",
    "scripts/verify-*.mjs",
    "scripts/ai/control.ps1",
    "scripts/ai/prepush-check.mjs",
    "scripts/ai/check-no-hardcode.mjs",
    "scripts/ai/hardcode-allowlist.json",
    "lefthook.yml",
    "pnpm-workspace.yaml",
    "**/.env*"
  ],
  "protected_paths": [
    "**/AGENTS.md",
    "**/CLAUDE.md",
    ".github/**",
    "apps/**",
    "packages/**",
    "prisma/**",
    "infra/**",
    "scripts/**",
    "tools/**",
    "docs/product-spec/docs/**",
    "docs/product-spec/contracts/**",
    "docs/product-spec/scripts/**",
    "**/openapi*.yaml",
    "**/openapi*.yml",
    "**/openapi*.json",
    ".gitleaks*",
    ".gitleaksignore",
    ".trivyignore",
    ".semgrep*",
    "tools/semgrep/**",
    "tools/openspec-check/**",
    "scripts/verify-trivy.ts",
    "scripts/ai/check-no-hardcode.mjs",
    "scripts/ai/hardcode-allowlist.json",
    "lefthook.yml",
    "package.json",
    "**/package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "**/.env*"
  ],
  "work_item_dir": "docs/product-spec/work-items/",
  "register_path": "docs/product-spec/docs/10-ai-collaboration/FEATURE-DELIVERY-REGISTER.csv",
  "terminal_statuses": ["MERGED", "SUPERSEDED"]
}
