{
  "version": 2,
  "description": "Path and operation rules for the Pull Request contract. Product behavior changes require a Work Item; declared maintenance and scoped governance operations use PR Goal/Scope/Verification without generating TASK-AI items. The validator always reads this file from the protected base commit, never from the PR head.",
  "maintenance_title_pattern": "^(chore|docs|refactor)(\\([a-z0-9._/-]+\\))?: \\S",
  "maintenance_body_headings": ["## Goal", "## Scope", "## Verification"],
  "governance_body_headings": ["## Goal", "## Scope", "## Preservation", "## Verification"],
  "maintenance_paths": ["docs/**", "*.md", ".evidence/**", "tools/ai-brain/test/**"],
  "scoped_governance_rules": [
    { "path": "AGENTS.md", "kinds": ["M"] },
    { "path": "docs/product-spec/docs/10-ai-collaboration/WORK-ITEM-TEMPLATE.md", "kinds": ["M"] },
    { "path": "docs/product-spec/docs/10-ai-collaboration/AGENT-CONTRACT-DETAILS.md", "kinds": ["M"] },
    { "path": "docs/product-spec/evidence/CURRENT-IMPLEMENTATION-INVENTORY.md", "kinds": ["M"] },
    { "path": "docs/product-spec/docs/10-ai-collaboration/repo-integration/GROUP-*.md", "kinds": ["M"] },
    { "path": "tools/ai-brain/data/tool-manifest.json", "kinds": ["M"] },
    { "path": "tools/ecosystem-manifest.json", "kinds": ["M"] },
    { "path": "tools/ai-brain/acceptance/ac-31-05-gate-rule.js", "kinds": ["D"] },
    { "path": "tools/ai-brain/acceptance/ac-31-06-gate-rule-refused.js", "kinds": ["D"] },
    { "path": "tools/ai-brain/acceptance/ac-31-07-grant-credential-free.js", "kinds": ["D"] },
    { "path": "tools/ai-brain/acceptance/ac-31-08-credential-in-grant.js", "kinds": ["D"] },
    { "path": "tools/ai-brain/acceptance/ac-31-10-unit-tests.js", "kinds": ["D"] },
    { "path": "tools/ai-brain/acceptance/ac-40-04-sylph-evidence.js", "kinds": ["D"] },
    { "path": "tools/ai-brain/acceptance/lib/qualification-gate.js", "kinds": ["D"] },
    { "path": "tools/ai-brain/acceptance/ac-31-09-outside-repository.js", "kinds": ["M"] },
    { "path": "apps/web/src/components/SourceMatchingTab.tsx", "kinds": ["D"] },
    { "path": "apps/web/src/components/forms/ConnectCarrierModal.tsx", "kinds": ["D"] },
    { "path": "apps/web/src/components/forms/CreateClaimModal.tsx", "kinds": ["D"] },
    { "path": "apps/web/src/components/forms/RateCardFormModal.tsx", "kinds": ["D"] },
    { "path": "apps/web/src/components/forms/ReattemptFormModal.tsx", "kinds": ["D"] },
    { "path": "apps/web/src/components/forms/ResolveDiscrepancyModal.tsx", "kinds": ["D"] },
    { "path": "apps/web/src/components/ui/DataTable.tsx", "kinds": ["D"] }
  ],
  "protected_paths": [
    "**/AGENTS.md",
    "**/CLAUDE.md",
    ".github/**",
    "apps/**",
    "packages/**",
    "prisma/**",
    "infra/**",
    "scripts/**",
    "docs/product-spec/docs/**",
    "docs/product-spec/contracts/**",
    "docs/product-spec/scripts/**",
    "**/openapi*.yaml",
    "**/openapi*.yml",
    "**/openapi*.json",
    ".gitleaks*",
    ".gitleaksignore",
    ".trivyignore",
    ".semgrep*",
    "tools/semgrep/**",
    "lefthook.yml",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "**/.env*"
  ],
  "work_item_dir": "docs/product-spec/work-items/",
  "register_path": "docs/product-spec/docs/10-ai-collaboration/FEATURE-DELIVERY-REGISTER.csv",
  "terminal_statuses": ["MERGED", "SUPERSEDED"]
}
