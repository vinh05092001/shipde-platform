{
  "name": "@shipde/worker",
  "version": "0.1.0",
  "description": "Ship Dễ — NestJS Background Worker & Outbox Dispatcher Foundation",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx --env-file-if-exists=.env watch src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/worker.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/client": "^6.19.2",
    "@shipde/config": "workspace:*",
    "@shipde/contracts": "workspace:*",
    "bullmq": "^5.41.6",
    "ioredis": "^5.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@shipde/testkit": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.5",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
