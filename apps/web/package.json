{
  "name": "@shipde/web",
  "version": "3.3.0",
  "description": "Ship Dễ (shipde.net) - Next.js Web Console Application",
  "private": true,
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
