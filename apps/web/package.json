  "description": "Ship Dễ (shipde.net) - Next.js Web Console Application",
  "private": true,
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/tests/comprehensive-rules.test.ts && tsx src/tests/admin-shops.test.ts && tsx src/tests/rbac-matrix-live.test.ts && tsx src/tests/roles-page-states.test.ts && tsx src/tests/profile-page-states.test.ts && tsx src/tests/user-scopes-states.test.ts && tsx src/app/settings/users/users-page-states.test.ts && tsx src/tests/shop-profile.test.ts && tsx src/tests/branches-page-states.test.ts && tsx src/tests/warehouses-page-states.test.ts && tsx src/tests/onboarding-page-states.test.ts && tsx src/tests/global-search-states.test.ts",
    "test:audit": "tsx src/tests/regression-audit.test.ts",
    "test:e2e": "tsx src/tests/e2e-scenarios.test.ts",
    "test:baseline": "tsx src/tests/preservation-smoke.test.ts",
    "db:generate": "prisma generate",
    "version:next": "next --version",
    "test:a11y": "playwright test",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry -o storybook-static"
  },
  "dependencies": {
