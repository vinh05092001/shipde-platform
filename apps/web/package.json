    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@shipde/testkit": "workspace:*",
    "@storybook/addon-a11y": "8.6.0",
    "@storybook/addon-essentials": "8.6.0",
    "@storybook/addon-highlight": "8.6.0",
    "@storybook/nextjs": "8.6.0",
