{
  "name": "@shipde/api",
  "version": "0.1.0",
  "description": "Ship Dễ — NestJS Modular Monolith API Foundation",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/main.js",
    "dev": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env watch src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/api.test.ts && tsx --tsconfig tsconfig.json src/api.supertest.spec.ts && tsx --tsconfig tsconfig.json src/auth/auth.supertest.spec.ts && tsx --tsconfig tsconfig.json src/auth/auth.login.supertest.spec.ts && tsx --tsconfig tsconfig.json src/auth/admin-auth.supertest.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.19.2",
    "@shipde/config": "workspace:*",
    "@shipde/contracts": "workspace:*",
    "ioredis": "^5.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@shipde/testkit": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.5",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
