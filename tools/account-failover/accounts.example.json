{
  "strategy": "priority_failover",
  "request_timeout_seconds": 120,
  "state_path": "state.json",
  "log_path": "logs/controller.log",
  "accounts": [
    {
      "name": "gemini-01",
      "type": "api_key",
      "credential_ref": "GEMINI_KEY_1",
      "priority": 1,
      "enabled": true,
      "cooldown_seconds": 300,
      "metadata": {
        "description": "Primary Gemini REST account",
        "endpoint": "REPLACE_WITH_THE_OFFICIAL_GENERATE_CONTENT_ENDPOINT",
        "credential_header": "x-goog-api-key",
        "body_style": "gemini_generate_content",
        "timeout_seconds": 120
      }
    },
    {
      "name": "agy-profile-current-user",
      "type": "antigravity_profile",
      "credential_ref": "",
      "priority": 2,
      "enabled": false,
      "cooldown_seconds": 300,
      "executable_path": "C:\\REPLACE\\WITH\\agy.exe",
      "args_template": ["REPLACE_WITH_VERIFIED_NONINTERACTIVE_FLAG", "{prompt}"],
      "profile_path": "C:\\REPLACE\\WITH\\PROFILE",
      "metadata": {
        "description": "Enable only after checking executable --help",
        "timeout_seconds": 120
      }
    },
    {
      "name": "agy-windows-user-02",
      "type": "windows_user",
      "credential_ref": "",
      "priority": 3,
      "enabled": false,
      "cooldown_seconds": 300,
      "windows_username": "REPLACE_WITH_LOCAL_WINDOWS_USERNAME",
      "scheduled_task_name": "ShipDe-Agy-User02-Worker",
      "task_request_path": "C:\\ProgramData\\ShipDe\\agy-user02\\request.json",
      "task_response_path": "C:\\ProgramData\\ShipDe\\agy-user02\\response.json",
      "executable_path": "C:\\REPLACE\\WITH\\agy.exe",
      "args_template": [],
      "profile_path": "C:\\REPLACE\\WITH\\PROFILE",
      "metadata": {
        "description": "Task must run under this user and implement the documented spool protocol",
        "timeout_seconds": 180
      }
    }
  ]
}
