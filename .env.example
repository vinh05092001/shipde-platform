# Ship Dễ — Local & Development Environment Configuration
# Copy this file to .env for local development. Never commit secrets to version control.

# Application Ports
PORT=3001
WORKER_HEALTH_PORT=3002
NODE_ENV=development

# Database (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/shipde_dev?schema=public"

# Redis (BullMQ Queue & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-Compatible Object Storage (Local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=shipde-local
S3_FORCE_PATH_STYLE=true

# Carrier Mode (disabled | mock | live)
# Production must strictly reject "mock" mode. Default is "disabled".
CARRIER_MODE=disabled

# Observability & Structured Logging (debug | info | warn | error)
LOG_LEVEL=info
