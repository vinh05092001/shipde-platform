{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@shipde/contracts": ["./packages/contracts/src/index.ts"],
      "@shipde/config": ["./packages/config/src/index.ts"],
      "@shipde/testkit": ["./packages/testkit/src/index.ts"],
      "@shipde/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "apps", "packages"]
}
